# Copy this file to .env.local and edit the path for your machine.
# .env.local is gitignored.

# Point this at your World of Warcraft Retail AddOns parent folder.
LURA_WOW_ADDONS_DIR=C:\Program Files (x86)\World of Warcraft\_retail_\Interface\AddOns

# Alternative: point directly at the addon folder instead of the AddOns parent.
# LURA_WOW_ADDON_DIR=C:\Program Files (x86)\World of Warcraft\_retail_\Interface\AddOns\LuraBrainBooster

# Optional: remove the existing deployed addon folder before copying.
# LURA_DEPLOY_CLEAN=0
